# Copy to .env and fill locally. Placeholders only. Never commit .env.

# Zetaris REST. Local Docker default from the participant guide.
# Leave ZETARIS_API_KEY blank. A key already in the process environment
# (a Windows user env var is enough) is used, and it overrides this file.
# Placeholder text such as your-zetaris-api-key is treated as unset.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_TIMEOUT_SECONDS=30

# Meterless Nightshift is the primary model provider.
# Copy the Runtime URL and runtime token from the Nightshift Console.
# The NVIDIA key stays in Nightshift's Providers tab, not here.
# Leave the token blank until Nightshift is installed. your-nightshift-runtime-token
# is treated as unset, so a copied example file does not call the network.
# Default chat model is nvidia/nemotron-3-super-120b-a12b. MODEL_NAME overrides METERLESS_MODEL.
# Nightshift may serve a different model than the one requested. The trace records both,
# and a served model outside nvidia/nemotron-* is flagged MODEL_MISMATCH. The served id
# is never rewritten to the id that was requested.
# Reasoning models need a large completion budget; 8192 is the default max_tokens.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3-super-120b-a12b
MODEL_NAME=
METERLESS_MAX_TOKENS=8192
METERLESS_APP=phoenixrepo
METERLESS_TIMEOUT_SECONDS=180

# Gate-1 Nightshift client (app/agents/relevance.py). These match the code defaults:
# 180 s per attempt, 360 s per call across retries, 4096 completion tokens, no extra body.
# Run `python scripts/nightshift_probe.py` first: it measures what this Nightshift serves and
# prints values for these lines. PHOENIX_LLM_EXTRA_BODY is a JSON object merged into each
# request, for example {"chat_template_kwargs":{"enable_thinking":false}}.
# On the scored run that object was set for the fast tier. It is not recorded on LLM_CALL lines.
PHOENIX_LLM_ATTEMPT_TIMEOUT_S=180
PHOENIX_LLM_TOTAL_TIMEOUT_S=360
PHOENIX_LLM_MAX_TOKENS=
PHOENIX_LLM_EXTRA_BODY=

# Two Nemotron tiers. MODEL_NAME is the fast model for the many overlap judgements.
# MODEL_NAME_DEEP (or PHOENIX_DEEP_MODEL) writes the final verdict (PHOENIX_DEEP_STEPS,
# default discovery) with its own body. /ui shows a reasoning field only when the trace
# line contains one. On the scored run, 0 of 16 final verdicts had one. The verdict still needs a quote found in the text.
# Blank MODEL_NAME_DEEP keeps one model for every step. The probe suggests both.
MODEL_NAME_DEEP=
PHOENIX_DEEP_STEPS=
PHOENIX_LLM_DEEP_EXTRA_BODY=

# What happens when Nightshift answers with a model that is not nvidia/nemotron-*:
#   label            (default) the answer is used and flagged MODEL_MISMATCH
#   require          the answer is discarded (traced as DISCARDED_BY_POLICY) and asked again
#   fallback-nvidia  the request is sent to the NVIDIA API with NVIDIA_API_KEY (also after a
#                    Nightshift timeout or 5xx); the trace line says provider nvidia-direct.
#                    The id sent is NVIDIA_MODEL, for both tiers (empty: the requested id).
PHOENIX_NEMOTRON_POLICY=label

# Opt-in hold for a future gate-1 run. Unset is off, so verdicts stay as they were
# before this switch. Unvalidated post-v3 change. Default off. Not in any reported number.
# Set to 1, true, yes, on, or enabled to hold a CANDIDATE as NEEDS_REVIEW when a
# full-overlap non-forge web page has a verified quote and only unknown blocker facts.
# PHOENIX_UNKNOWN_BLOCKER_REVIEW=

# Per-repo alternatives budget. Only failed Nightshift calls spend it.
# Unset uses max(PHOENIX_ALTERNATIVES_BUDGET_FLOOR_S, PHOENIX_ALTERNATIVES_CHUNK_SECONDS × chunks),
# then PHOENIX_ALTERNATIVES_BUDGET_CAP_S. PHOENIX_ALTERNATIVES_BUDGET_S replaces the formula
# and is still limited by the cap. One attempt is also bounded by the client total timeout.
# PHOENIX_ALTERNATIVES_BUDGET_S=
# PHOENIX_ALTERNATIVES_BUDGET_FLOOR_S=600
# PHOENIX_ALTERNATIVES_CHUNK_SECONDS=90
# PHOENIX_ALTERNATIVES_BUDGET_CAP_S=3600

# Optional secondary dev fallback. Leave LLM_PROVIDER=meterless for the demo.
# NVIDIA_MODEL is the id sent by fallback-nvidia. The API answered 404 for
# nvidia/nemotron-3-super-120b-a12b on the author's account; ultra is what answered.
# nemotron-3.5-super-vl-120b was reported flaky.
LLM_PROVIDER=meterless
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# SAMPLE_MODE=true runs the real investigation on data/sample with no credentials.
SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000
HMEM_STORE_PATH=data/hmem/runtime-store.json
# Step budget. The code default is 190: the Nightshift chat client then uses min(180, 189) = 180s.
# Nightshift calls have been observed taking up to ~280s, so a smaller budget turns them into stand-ins.
AGENT_STEP_TIMEOUT_SECONDS=190
RUN_TIMEOUT_SECONDS=600
