@@ -1,5 +1,6 @@
 """SQL the agents are allowed to send. One statement, one view, one predicate."""
 
+import os
 import re
 
 REPO_ID_PATTERN = re.compile(r"^[A-Za-z0-9_./:-]{1,200}$")
@@ -140,6 +141,24 @@ ALTERNATIVES_LOW_AT_MOST = 5
 ALTERNATIVES_MODERATE_AT_MOST = 30
 
 
+# Zetaris schemastore container the gate-1 SELECTs read. Default "phoenix" is the
+# existing container. A run that must read a different container (for example a
+# separate evaluation load) sets PHOENIX_ZETARIS_SCHEMA. No other behaviour changes.
+DEFAULT_SCHEMA = "phoenix"
+_SCHEMA_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,62}$")
+
+
+def evidence_schema() -> str:
+    value = os.environ.get("PHOENIX_ZETARIS_SCHEMA", "").strip() or DEFAULT_SCHEMA
+    if not _SCHEMA_PATTERN.fullmatch(value):
+        raise ValueError("PHOENIX_ZETARIS_SCHEMA must be a plain identifier (letters, digits, underscore).")
+    return value
+
+
+def view_name(view: str) -> str:
+    return f"{evidence_schema()}.{view}"
+
+
 def require_repo_id(repository: str) -> str:
     repo_id = repository.strip()
     if not REPO_ID_PATTERN.fullmatch(repo_id):
@@ -188,7 +207,7 @@ def sources_sql(repo_id: str) -> str:
 def discovery_sql(repo_id: str) -> str:
     columns = ", ".join(DISCOVERY_COLUMNS)
